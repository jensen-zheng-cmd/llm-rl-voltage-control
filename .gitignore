# Large source data and generated experiment artifacts stay local.
/data/raw/
/data/processed/
/runs/
/outputs/
/cache/
/tmp/

# Reference PDFs and page renders are recoverable local reading material.
/references/**/*.pdf
/references/**/rendered-pages/
/references/**/rendered-supplement/
/原论文/*.pdf

# Python environments and caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local credentials and machine-generated files.
.env
.env.*
!.env.example
*.log
Thumbs.db
Desktop.ini
.DS_Store
