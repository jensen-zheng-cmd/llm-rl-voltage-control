# Large source data and generated experiment artifacts stay local.
/data/raw/
/data/processed/
/runs/
/outputs/
/cache/
/tmp/

# Reference PDFs and page renders are recoverable local reading material.
/references/**/*.pdf
/support/**/*.pdf
/support/**/rendered-pages/
/support/**/rendered-supplement/
/support/重复资料/

# Python environments and caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local credentials and machine-generated files.
.env
.env.*
!.env.example
*.log
Thumbs.db
Desktop.ini
.DS_Store
